{
  "name": "wazalgames-center",
  "version": "1.0.0",
  "description": "WazalGames Center - Game Distribution Platform",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:exe": "vite build && electron-builder --win portable",
    "load-local-games": "node scripts/load-local-games.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "firebase": "^10.7.0",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.wazalgames.center",
    "productName": "WazalGamesCenter",
    "directories": {
      "output": "dist-v4"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "artifactName": "WazalGamesCenter.exe",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
